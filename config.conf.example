[defaults]

# Path to the mkvmerge binary. Empty = search PATH.
mkvmerge_path = /usr/bin/mkvmerge

# debug | info | warning | error
log_level = info

# true = detect and report only, make no changes
dry_run = false

# keep | move | delete
#   keep   -> originals left untouched (torrent/NZB keeps seeding). DEFAULT.
#   move   -> originals moved into backup_dir after verified merge
#   delete -> originals removed after verified merge
cleanup_mode = keep
backup_dir = .merged-parts

# Maximum number of parts in one episode group
max_parts = 9

# Trust a part only if >= this size (bytes). Guards against empty/corrupt parts.
min_part_size = 10485760

# Validate each part with `mkvmerge -i` and require identical track layout
# across parts before merging (best desync protection). Requires mkvmerge to be
# present even in dry-run mode.
check_tracks = true

# Sonarr trigger: POST DownloadedEpisodesScan for the download folder after a
# merge so Sonarr imports the new merged file.
sonarr_url = http://127.0.0.1:8989
sonarr_apikey =
sonarr_trigger = true
